{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitchen-mode.local/schemas/recipe-v1.json",
  "title": "Kitchen Mode Recipe V1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "identity",
    "yield",
    "ingredients",
    "components",
    "preparation",
    "cooking"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "identity": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "classification": {
      "type": "object"
    },
    "history": {
      "type": "object"
    },
    "yield": {
      "type": "object",
      "required": ["baseServings"],
      "properties": {
        "baseServings": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "timing": {
      "type": "object"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gathering": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "foodId",
          "name",
          "quantity",
          "componentId",
          "optional",
          "scaling"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "foodId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "componentId": {
            "type": "string"
          },
          "optional": {
            "type": "boolean"
          },
          "scaling": {
            "enum": ["linear", "fixed", "manual"]
          },
          "quantity": {
            "$ref": "#/$defs/quantity"
          },
          "gathering": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "form": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "enum": ["produce", "fridge", "oils", "dry-goods", "other"]
              },
              "detail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "quantityUsages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preparation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/prepStage"
      }
    },
    "cooking": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cookStage"
      }
    },
    "serving": {
      "type": "object"
    },
    "storage": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "quantity": {
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            },
            "package": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["min", "max", "unit"],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "unit": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "prepStage": {
      "type": "object",
      "required": ["id", "title", "items"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tip": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "checkable"],
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "checkable": {
                "type": "boolean"
              },
              "content": {
                "$ref": "#/$defs/content"
              },
              "longLead": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "longLead": {
          "type": "boolean"
        },
        "earlyTitle": {
          "type": "string",
          "minLength": 1
        },
        "continuationTitle": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "cookStage": {
      "type": "object",
      "required": ["id", "title", "instructions", "checklist", "timers"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tip": {
          "type": "string"
        },
        "componentId": {
          "type": "string"
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "text"],
                "properties": {
                  "type": {
                    "const": "text"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "ingredientId"],
                "properties": {
                  "type": {
                    "const": "quantity"
                  },
                  "ingredientId": {
                    "type": "string"
                  },
                  "usageId": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "durationSeconds"],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "durationSeconds": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "content": {
          "$ref": "#/$defs/content"
        }
      },
      "additionalProperties": true
    },
    "ingredientReference": {
      "type": "object",
      "required": ["ingredientId"],
      "properties": {
        "ingredientId": {
          "type": "string",
          "minLength": 1
        },
        "usageId": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": {
                "const": "action"
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "title", "items"],
            "properties": {
              "type": {
                "const": "ingredients"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/ingredientReference"
                }
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
