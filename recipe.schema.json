{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kitchen-mode.local/schemas/recipe-v1.json",
  "title": "Kitchen Mode Recipe V1",
  "type": "object",
  "required": ["schemaVersion", "id", "revision", "identity", "yield", "ingredients", "components", "preparation", "cooking"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "identity": {"type": "object", "required": ["title"], "properties": {"title": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "classification": {"type": "object"},
    "history": {"type": "object"},
    "yield": {"type": "object", "required": ["baseServings"], "properties": {"baseServings": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": true},
    "timing": {"type": "object"},
    "media": {"type": "array", "items": {"type": "object", "required": ["id", "path"], "properties": {"id": {"type": "string"}, "path": {"type": "string"}}, "additionalProperties": true}},
    "equipment": {"type": "array", "items": {"type": "object"}},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}}, "additionalProperties": true}},
    "ingredients": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "foodId", "name", "quantity", "componentId", "optional", "scaling"], "properties": {"id": {"type": "string"}, "foodId": {"type": "string"}, "name": {"type": "string"}, "componentId": {"type": "string"}, "optional": {"type": "boolean"}, "scaling": {"enum": ["linear", "fixed", "manual"]}, "quantity": {"$ref": "#/$defs/quantity"}}, "additionalProperties": true}},
    "quantityUsages": {"type": "array", "items": {"type": "object"}},
    "preparation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/prepStage"}},
    "cooking": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cookStage"}},
    "serving": {"type": "object"},
    "storage": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false,
  "$defs": {
    "quantity": {"oneOf": [
      {"type": "object", "required": ["value", "unit"], "properties": {"value": {"type": "number"}, "unit": {"type": "string"}, "package": {"type": "object"}}, "additionalProperties": false},
      {"type": "object", "required": ["min", "max", "unit"], "properties": {"min": {"type": "number"}, "max": {"type": "number"}, "unit": {"type": "string"}}, "additionalProperties": false},
      {"type": "object", "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}}, "additionalProperties": false}
    ]},
    "prepStage": {"type": "object", "required": ["id", "title", "items"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "tip": {"type": "string"}, "items": {"type": "array", "items": {"type": "object", "required": ["id", "text", "checkable"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "checkable": {"type": "boolean"}}, "additionalProperties": false}}}, "additionalProperties": true},
    "cookStage": {"type": "object", "required": ["id", "title", "instructions", "checklist", "timers"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "tip": {"type": "string"}, "componentId": {"type": "string"}, "instructions": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "text"}, "text": {"type": "string"}}, "additionalProperties": false}, {"type": "object", "required": ["type", "ingredientId"], "properties": {"type": {"const": "quantity"}, "ingredientId": {"type": "string"}, "usageId": {"type": "string"}}, "additionalProperties": false}]}}, "checklist": {"type": "array", "items": {"type": "object"}}, "timers": {"type": "array", "items": {"type": "object", "required": ["id", "label", "durationSeconds"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "durationSeconds": {"type": "integer", "minimum": 1}}, "additionalProperties": false}}}, "additionalProperties": true}
  }
}
