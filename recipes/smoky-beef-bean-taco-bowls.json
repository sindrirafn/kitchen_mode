  "quantityUsages": [],
  "preparation": [
    {
      "id": "prep-rice",
      "title": "Start and organize",
      "items": [
        {
          "id": "prep-rice-1",
          "text": "Measure 300 g dry rice and start cooking according to the package, timing it to finish near serving.",
          "checkable": true
        },
        {
          "id": "prep-rice-2",
          "text": "Dice 1 onion and 1 bell pepper.",
          "checkable": true
        },
        {
          "id": "prep-rice-3",
          "text": "Rinse and drain the black beans and kidney beans; drain 2 cans sweetcorn.",
          "checkable": true
        }
      ]
    },
    {
      "id": "prep-spices",
      "title": "Measure spices and sauce",
      "items": [
        {
          "id": "prep-spices-1",
          "text": "Mix 2 tsp cumin, 2 tsp paprika, 1½ tsp garlic powder, 1 tsp oregano, ½ tsp black pepper and optional ¼–½ tsp chili.",
          "checkable": true
        },
        {
          "id": "prep-spices-2",
          "text": "For the sauce, measure 125 g Greek yogurt, 1–2 tsp lime juice, optional ½ tsp zest, ¼ tsp garlic powder, ¼ tsp oregano and ¼ tsp salt.",
          "checkable": true
        }
      ]
    }
  ],
  "cooking": [
    {
      "id": "cook-1",
      "title": "Brown the beef",
      "instructions": [
        {
          "type": "text",
          "text": "Heat 1 tbsp oil in a skillet. Brown 275 g minced beef, then transfer it to a plate."
        }
      ],
      "checklist": [],
      "timers": []
    },
    {
      "id": "cook-2",
      "title": "Soften the vegetables",
      "instructions": [
        {
          "type": "text",
          "text": "Cook the diced onion and bell pepper in the same pan for 6–8 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-2-timer-1",
          "label": "Sauté vegetables",
          "durationSeconds": 360
        }
      ]
    },
    {
      "id": "cook-3",
      "title": "Bloom the seasoning",
      "instructions": [
        {
          "type": "text",
          "text": "Stir in the prepared cumin-paprika seasoning and optional 1 tbsp tomato paste. Cook for about 1 minute."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-3-timer-1",
          "label": "Bloom seasoning",
          "durationSeconds": 60
        }
      ],
      "tip": "Briefly heating spices in oil releases their aromas."
    },
    {
      "id": "cook-4",
      "title": "Simmer the filling",
      "instructions": [
        {
          "type": "text",
          "text": "Return the beef; add 400 g chopped tomatoes, the drained black and kidney beans and initially ½ tsp salt. Simmer uncovered for 12–15 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-4-timer-1",
          "label": "Simmer filling",
          "durationSeconds": 720
        }
      ]
    },
    {
      "id": "cook-5",
      "title": "Add the corn",
      "instructions": [
        {
          "type": "text",
          "text": "Stir in both drained cans of sweetcorn for the final 5 minutes of cooking. Taste and adjust salt."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-5-timer-1",
          "label": "Warm sweetcorn",
          "durationSeconds": 300
        }
      ]
    },
    {
      "id": "cook-6",
      "title": "Mix the lime-yogurt sauce",
      "instructions": [
        {
          "type": "text",
          "text": "Combine 125 g Greek yogurt, 1–2 tsp lime juice, optional zest, ¼ tsp garlic powder, ¼ tsp oregano and ¼ tsp salt. Thin with cold water if needed; add an optional pinch of sugar if desired. Chill 10–15 minutes when practical."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-6-timer-1",
          "label": "Chill sauce",
          "durationSeconds": 600
        }
      ]
    },
    {
      "id": "cook-7",
      "title": "Build the bowls",
      "instructions": [
        {
          "type": "text",
          "text": "Spoon rice into bowls. Add the smoky beef, beans and corn, then finish with the lime-yogurt sauce and optional nachos. The sauce is an essential part of the tested favorite."
        }
      ],
      "checklist": [],
      "timers": []
    }
  ],
  "serving": {
    "instructions": "Serve rice bowls with the lime-yogurt sauce and optional nachos."
  },
