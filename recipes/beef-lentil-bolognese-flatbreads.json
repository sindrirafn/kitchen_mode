  "quantityUsages": [],
  "preparation": [
    {
      "id": "prep-vegetables",
      "title": "Prepare the ragù ingredients",
      "items": [
        {
          "id": "prep-vegetables-1",
          "text": "Finely dice 1 onion, 1 carrot and 2 celery stalks.",
          "checkable": true
        },
        {
          "id": "prep-vegetables-2",
          "text": "Chop 3 fresh tomatoes.",
          "checkable": true
        },
        {
          "id": "prep-vegetables-3",
          "text": "Measure 100–125 g dry green lentils and prepare ½ beef stock cube in 150 ml water.",
          "checkable": true
        },
        {
          "id": "prep-vegetables-4",
          "text": "Have minced beef, tomato paste, canned tomatoes, herbs and 100–150 ml milk ready.",
          "checkable": true
        }
      ]
    },
    {
      "id": "prep-flatbread",
      "title": "Measure flatbread ingredients",
      "items": [
        {
          "id": "prep-flatbread-1",
          "text": "Measure 300 g flour, 225 g Greek yogurt, 2¼ tsp baking powder and ¾ tsp salt.",
          "checkable": true
        },
        {
          "id": "prep-flatbread-2",
          "text": "Reserve 50–60 g butter and 1½–2 tsp garlic powder for finishing.",
          "checkable": true
        },
        {
          "id": "prep-flatbread-3",
          "text": "Prepare rolling pin and dry skillet for later; do not preheat the skillet yet.",
          "checkable": true
        }
      ]
    }
  ],
  "cooking": [
    {
      "id": "cook-1",
      "title": "Brown the beef",
      "instructions": [
        {
          "type": "text",
          "text": "Heat 1–2 tbsp oil in a pot. Brown 250–300 g minced beef, then transfer it to a plate."
        }
      ],
      "checklist": [],
      "timers": []
    },
    {
      "id": "cook-2",
      "title": "Build the vegetable base",
      "instructions": [
        {
          "type": "text",
          "text": "In the same pot, sweat the onion, carrot and celery for 12–15 minutes, until softened."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-2-timer-1",
          "label": "Soften vegetables",
          "durationSeconds": 720
        }
      ]
    },
    {
      "id": "cook-3",
      "title": "Develop the tomato flavor",
      "instructions": [
        {
          "type": "text",
          "text": "Fry 2 tbsp tomato paste for about 2 minutes, then add 3 chopped fresh tomatoes and cook them down for another 5–10 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-3-timer-1",
          "label": "Cook fresh tomatoes",
          "durationSeconds": 300
        }
      ]
    },
    {
      "id": "cook-4",
      "title": "Simmer the ragù",
      "instructions": [
        {
          "type": "text",
          "text": "Return beef. Add 400 g chopped tomatoes, ½ stock cube dissolved in 150 ml water, 100–150 ml milk and 1 tsp oregano. Add optional thyme, bay leaf or Worcestershire sauce if using. Simmer very gently for around 2 hours, stirring occasionally; loosen with water if needed."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-4-timer-1",
          "label": "Long ragù simmer",
          "durationSeconds": 7200
        }
      ]
    },
    {
      "id": "cook-5",
      "title": "Cook the lentils",
      "instructions": [
        {
          "type": "text",
          "text": "While the ragù simmers, boil 100–125 g dry green lentils separately until tender, roughly 20–35 minutes. Drain, then add them to the ragù for the final 15–20 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-5-timer-1",
          "label": "Check lentils",
          "durationSeconds": 1200
        }
      ],
      "tip": "Cooking green lentils separately was part of the tested version; the red-lentil alternative is not tested."
    },
    {
      "id": "cook-6",
      "title": "Mix the flatbread dough",
      "instructions": [
        {
          "type": "text",
          "text": "Mix 300 g flour, 225 g Greek yogurt, 2¼ tsp baking powder and ¾ tsp salt into a dough. Add only a little optional oil or milk if needed. Knead briefly, rest 5–10 minutes, then divide into 6 pieces."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-6-timer-1",
          "label": "Dough rest",
          "durationSeconds": 600
        }
      ]
    },
    {
      "id": "cook-7",
      "title": "Cook the garlic flatbreads",
      "instructions": [
        {
          "type": "text",
          "text": "Roll the 6 pieces into approximately 15–18 cm rounds. Heat a dry skillet and cook each for about 1½–2 minutes per side. Melt 50–60 g butter with 1½–2 tsp garlic powder and brush the breads."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-7-timer-1",
          "label": "Flatbread side",
          "durationSeconds": 90
        }
      ]
    },
    {
      "id": "cook-8",
      "title": "Cook the pasta and serve",
      "instructions": [
        {
          "type": "text",
          "text": "Cook 350–400 g farfalle according to the package until al dente. Combine with ragù, adding a little pasta water as needed, and serve with Parmigiano and warm garlic flatbreads."
        }
      ],
      "checklist": [],
      "timers": []
    }
  ],
  "serving": {
    "instructions": "Serve the farfalle with Parmigiano and garlic-butter flatbreads."
  },
