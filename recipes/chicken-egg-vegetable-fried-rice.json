  "quantityUsages": [],
  "preparation": [
    {
      "id": "prep-rice",
      "title": "Cook and chill the rice",
      "items": [
        {
          "id": "prep-rice-1",
          "text": "Cook 6 dl dry rice (roughly 470–510 g, depending on variety) ahead of time.",
          "checkable": true
        },
        {
          "id": "prep-rice-2",
          "text": "Spread the cooked rice thinly to cool quickly, then refrigerate promptly until cold and dry. Do not leave cooked rice at room temperature for extended periods.",
          "checkable": true
        }
      ],
      "tip": "Cold, dry rice fries more cleanly; cool and refrigerate promptly for food safety."
    },
    {
      "id": "prep-parts",
      "title": "Prepare the individual components",
      "items": [
        {
          "id": "prep-parts-1",
          "text": "Dice 450 g boneless chicken thighs.",
          "checkable": true
        },
        {
          "id": "prep-parts-2",
          "text": "Beat 6 eggs.",
          "checkable": true
        },
        {
          "id": "prep-parts-3",
          "text": "Dice 1 onion and 150–200 g sweet Palermo peppers.",
          "checkable": true
        },
        {
          "id": "prep-parts-4",
          "text": "Measure 800–1000 g frozen wok vegetables. Prepare a large receiving bowl for the cooked batches.",
          "checkable": true
        }
      ]
    },
    {
      "id": "prep-sauce",
      "title": "Mix the cooking sauce",
      "items": [
        {
          "id": "prep-sauce-1",
          "text": "Mix 5 tbsp light soy sauce, 2 tbsp oyster sauce, 2 tsp rice vinegar, 1 tsp sugar, 1 tsp garlic powder and ½ tsp black pepper.",
          "checkable": true
        },
        {
          "id": "prep-sauce-2",
          "text": "Reserve 2 tsp toasted sesame oil for the end; keep 3–4 tbsp neutral oil for batch frying.",
          "checkable": true
        },
        {
          "id": "prep-sauce-3",
          "text": "Divide sauce mentally into roughly thirds for the rice batches.",
          "checkable": true
        }
      ]
    }
  ],
  "cooking": [
    {
      "id": "cook-1",
      "title": "Brown the chicken",
      "instructions": [
        {
          "type": "text",
          "text": "Using some of the neutral oil, brown 450 g diced chicken thighs in batches in a hot wide pan until the chicken reaches at least 74°C. Transfer to the receiving bowl."
        }
      ],
      "checklist": [],
      "timers": []
    },
    {
      "id": "cook-2",
      "title": "Soft-scramble the eggs",
      "instructions": [
        {
          "type": "text",
          "text": "Gently scramble 6 beaten eggs until softly set. Remove to the bowl with the chicken."
        }
      ],
      "checklist": [],
      "timers": []
    },
    {
      "id": "cook-3",
      "title": "Cook the vegetables",
      "instructions": [
        {
          "type": "text",
          "text": "Sauté the diced onion and Palermo peppers for 4–5 minutes. Add 800–1000 g frozen wok vegetables and cook until their released moisture evaporates, then remove."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-3-timer-1",
          "label": "Onion and pepper",
          "durationSeconds": 240
        }
      ]
    },
    {
      "id": "cook-4",
      "title": "Fry the cold rice in batches",
      "instructions": [
        {
          "type": "text",
          "text": "Heat more neutral oil in the wide stainless pan. Fry the cold cooked rice in approximately 3 batches, letting the rice sit 20–30 seconds between stirs to encourage browning. Add approximately one-third of the prepared sauce to each batch; toss and transfer to the large bowl."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-4-timer-1",
          "label": "Undisturbed rice interval",
          "durationSeconds": 25
        }
      ],
      "tip": "Smaller batches prevent steaming and produced the excellent texture recorded in the tested version."
    },
    {
      "id": "cook-5",
      "title": "Combine and finish",
      "instructions": [
        {
          "type": "text",
          "text": "Combine the fried rice, cooked chicken, eggs and vegetables in the large bowl. Drizzle with 2 tsp toasted sesame oil and toss. Taste and adjust seasoning if needed."
        }
      ],
      "checklist": [],
      "timers": []
    },
    {
      "id": "cook-6",
      "title": "Serve promptly",
      "instructions": [
        {
          "type": "text",
          "text": "Serve hot and refrigerate leftovers promptly. Extra soy sauce and rice vinegar were added at the table in the tested meal, but their amounts were not recorded."
        }
      ],
      "checklist": [],
      "timers": []
    }
  ],
  "serving": {
    "instructions": "Serve hot; lime wedges are an untested future suggestion, not part of original tested recipe."
  },
