  "cooking": [
    {
      "id": "cook-1",
      "title": "Start the chicken roast",
      "instructions": [
        {
          "type": "text",
          "text": "Put the chicken on its rack above the vegetables in the preheated oven. Roast for 10 minutes before adding the potatoes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-1-timer-1",
          "label": "Head start for chicken",
          "durationSeconds": 600
        }
      ],
      "content": [
        {
          "type": "action",
          "text": "Put the chicken on its rack above the vegetables in the preheated oven."
        },
        {
          "type": "action",
          "text": "Roast for 10 minutes before adding the potatoes."
        }
      ]
    },
    {
      "id": "cook-2",
      "title": "Add the potato tray",
      "instructions": [
        {
          "type": "text",
          "text": "Slide the prepared potato tray into the oven, cut-side down. Leave the potatoes undisturbed—do not flip."
        }
      ],
      "checklist": [],
      "timers": [],
      "tip": "Contact with the metal tray creates the deeply browned potato cut sides.",
      "content": [
        {
          "type": "action",
          "text": "Slide the prepared potato tray into the oven, cut-side down."
        },
        {
          "type": "action",
          "text": "Leave the potatoes undisturbed—do not flip."
        }
      ]
    },
    {
      "id": "cook-3",
      "title": "Check the roast",
      "instructions": [
        {
          "type": "text",
          "text": "At about 35 minutes total for the chicken (25 minutes for the potatoes), inspect browning and use a thermometer in the thickest chicken piece, away from bone."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-3-timer-1",
          "label": "First doneness check",
          "durationSeconds": 1500
        }
      ],
      "tip": "Chicken must reach at least 74°C; dark meat often tastes better around 80–85°C."
    },
    {
      "id": "cook-4",
      "title": "Finish cooking",
      "instructions": [
        {
          "type": "text",
          "text": "Continue roasting as needed. Chicken typically takes about 40–55 minutes total, and potatoes about 30–40 minutes; use temperature, tenderness and browning rather than the clock alone. If drippings start burning, add a splash of water beneath the vegetables only."
        }
      ],
      "checklist": [],
      "timers": []
    },
    {
      "id": "cook-5",
      "title": "Butter the vegetables and rest",
      "instructions": [
        {
          "type": "text",
          "text": "Remove the chicken and rest uncovered 5–10 minutes. Toss the roasted carrots and onions with the chicken drippings, 20–25 g butter and a pinch of garlic powder. Add optional lemon juice to taste."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-5-timer-1",
          "label": "Chicken rest",
          "durationSeconds": 300
        }
      ],
      "content": [
        {
          "type": "action",
          "text": "Remove the chicken and rest uncovered 5–10 minutes."
        },
        {
          "type": "action",
          "text": "Toss the roasted carrots and onions with the chicken drippings and:"
        },
        {
          "type": "ingredients",
          "title": "Vegetable finish",
          "items": [
            {
              "ingredientId": "butter"
            },
            {
              "ingredientId": "finish-garlic"
            }
          ]
        },
        {
          "type": "action",
          "text": "Add optional lemon juice to taste."
        }
      ]
    },
