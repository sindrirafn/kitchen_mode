  "quantityUsages": [],
  "preparation": [
    {
      "id": "prep-naan",
      "title": "Start the naan dough early",
      "items": [
        {
          "id": "prep-naan-1",
          "text": "Mix 450 g flour, 7 g dry yeast, 1 tbsp sugar and 1 tsp salt.",
          "checkable": true
        },
        {
          "id": "prep-naan-2",
          "text": "Add 250 ml milk and 2 tbsp oil; add water only as needed for a workable dough. Knead 6–8 minutes.",
          "checkable": true
        },
        {
          "id": "prep-naan-3",
          "text": "Cover and leave to rise 45–60 minutes. This long-lead step comes first.",
          "checkable": true
        }
      ],
      "tip": "Starting the dough before the curry gives the yeast time to work."
    },
    {
      "id": "prep-curry",
      "title": "Prepare the curry ingredients",
      "items": [
        {
          "id": "prep-curry-1",
          "text": "Dice 1 large onion and about 100–150 g sweet Palermo pepper.",
          "checkable": true
        },
        {
          "id": "prep-curry-2",
          "text": "Open 2 cans coconut milk; drain 3 cans chickpeas.",
          "checkable": true
        },
        {
          "id": "prep-curry-3",
          "text": "Measure ½ tsp mustard seeds separately. Combine 3 tbsp mild curry powder, 2 tsp cumin, 1½ tsp garlic powder and ½ tsp ground ginger.",
          "checkable": true
        },
        {
          "id": "prep-curry-4",
          "text": "Have 450 g chicken thighs, rice, salt and optional finishing seasonings ready.",
          "checkable": true
        }
      ]
    },
    {
      "id": "prep-equipment",
      "title": "Ready the cooking equipment",
      "items": [
        {
          "id": "prep-equipment-1",
          "text": "Set out a large pot for the curry, a rice pot and a dry skillet for naan.",
          "checkable": true
        },
        {
          "id": "prep-equipment-2",
          "text": "Have butter and garlic available to brush onto the naan.",
          "checkable": true
        },
        {
          "id": "prep-equipment-3",
          "text": "Do not preheat the dry naan skillet until the dough is ready to cook.",
          "checkable": true
        }
      ]
    }
  ],
  "cooking": [
    {
      "id": "cook-1",
      "title": "Soften onion and pepper",
      "instructions": [
        {
          "type": "text",
          "text": "Heat the curry oil in a large pot. Sauté the diced onion 8–10 minutes; add the diced Palermo pepper for the final 4–5 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-1-timer-1",
          "label": "Onion sauté",
          "durationSeconds": 480
        }
      ]
    },
    {
      "id": "cook-2",
      "title": "Bloom the mustard and spices",
      "instructions": [
        {
          "type": "text",
          "text": "Add ½ tsp mustard seeds to the oil and cook around 45–60 seconds, then stir in the prepared curry powder, cumin, garlic powder and ginger for approximately 30 seconds."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-2-timer-1",
          "label": "Spice bloom",
          "durationSeconds": 30
        }
      ],
      "tip": "Blooming the spices in fat builds aroma; keep them moving to avoid scorching."
    },
    {
      "id": "cook-3",
      "title": "Simmer the chicken",
      "instructions": [
        {
          "type": "text",
          "text": "Pour in 800 ml coconut milk. Add 450 g boneless chicken thighs, roughly 1 tsp salt and pepper. Simmer gently until the thickest chicken reaches at least 74°C. Frozen thighs can take 25–40 minutes or longer; measure temperature rather than relying on time."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-3-timer-1",
          "label": "First chicken check",
          "durationSeconds": 1200
        }
      ]
    },
    {
      "id": "cook-4",
      "title": "Start the rice",
      "instructions": [
        {
          "type": "text",
          "text": "Cook 350–400 g dry rice according to package directions so that it finishes around the time of the curry."
        }
      ],
      "checklist": [],
      "timers": []
    },
    {
      "id": "cook-5",
      "title": "Add chickpeas and finish curry",
      "instructions": [
        {
          "type": "text",
          "text": "Stir in the drained chickpeas for the final 10–15 minutes. Shred the fully cooked chicken and return it to the curry. Simmer uncovered or mash a few chickpeas if the sauce needs thickening. Taste, then add optional garam masala, citrus or a little sugar as desired."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-5-timer-1",
          "label": "Chickpea simmer",
          "durationSeconds": 600
        }
      ]
    },
    {
      "id": "cook-6",
      "title": "Shape the naan",
      "instructions": [
        {
          "type": "text",
          "text": "Once the dough has risen for 45–60 minutes, divide into six portions and rest 10 minutes. Roll each portion fairly thin."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-6-timer-1",
          "label": "Naan rest",
          "durationSeconds": 600
        }
      ]
    },
    {
      "id": "cook-7",
      "title": "Cook the naan",
      "instructions": [
        {
          "type": "text",
          "text": "Heat a dry skillet. Cook each naan approximately 1–2 minutes per side until blistered and cooked through; brush with butter and garlic. Work in batches as needed."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-7-timer-1",
          "label": "Naan side",
          "durationSeconds": 90
        }
      ]
    },
    {
      "id": "cook-8",
      "title": "Serve the full meal",
      "instructions": [
        {
          "type": "text",
          "text": "Serve the coconut chicken-and-chickpea curry with cooked rice and warm garlic-butter naan. Taste the curry before serving; it can still be mildly spicy without added chili."
        }
      ],
      "checklist": [],
      "timers": []
    }
  ],
  "serving": {
    "instructions": "Serve with rice and freshly cooked garlic-butter naan."
  },
