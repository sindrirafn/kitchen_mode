  "preparation": [
    {
      "id": "prep-ingredients",
      "title": "Get everything ready",
      "items": [
        {
          "id": "prep-ingredients-1",
          "text": "Finely dice 1 onion.",
          "checkable": true
        },
        {
          "id": "prep-ingredients-2",
          "text": "Drain both cans of kidney beans.",
          "checkable": true
        },
        {
          "id": "prep-ingredients-3",
          "text": "Measure paprika, cumin, curry powder, garlic powder and ground ginger together; keep the garam masala separate.",
          "checkable": true
        },
        {
          "id": "prep-ingredients-4",
          "text": "Open both cans of chopped tomatoes.",
          "checkable": true
        },
        {
          "id": "prep-ingredients-5",
          "text": "Have rice and/or naan ready to serve (accompaniments not quantified in the tested bank).",
          "checkable": true
        }
      ]
    }
  ],
  "cooking": [
    {
      "id": "cook-1",
      "title": "Soften the onion",
      "instructions": [
        {
          "type": "text",
          "text": "Heat "
        },
        {
          "type": "quantity",
          "ingredientId": "oil"
        },
        {
          "type": "text",
          "text": " in a skillet over medium heat. Add the diced onion and sauté for about 4 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-1-timer-1",
          "label": "Onion",
          "durationSeconds": 240
        }
      ]
    },
    {
      "id": "cook-2",
      "title": "Bloom the spices",
      "instructions": [
        {
          "type": "text",
          "text": "Add 2 tsp paprika, 1½ tsp ground cumin, 1 tsp curry powder, ½ tsp garlic powder and ½ tsp ground ginger. Stir for 20–30 seconds."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-2-timer-1",
          "label": "Bloom spices",
          "durationSeconds": 30
        }
      ],
      "tip": "Briefly warming the spices in oil helps release fat-soluble aromas."
    },
    {
      "id": "cook-3",
      "title": "Simmer the tomatoes",
      "instructions": [
        {
          "type": "text",
          "text": "Add "
        },
        {
          "type": "quantity",
          "ingredientId": "tomatoes"
        },
        {
          "type": "text",
          "text": " and "
        },
        {
          "type": "quantity",
          "ingredientId": "salt"
        },
        {
          "type": "text",
          "text": ". Simmer uncovered for 5 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-3-timer-1",
          "label": "Tomato simmer",
          "durationSeconds": 300
        }
      ]
    },
    {
      "id": "cook-4",
      "title": "Add the beans",
      "instructions": [
        {
          "type": "text",
          "text": "Stir in "
        },
        {
          "type": "quantity",
          "ingredientId": "kidney-beans"
        },
        {
          "type": "text",
          "text": ". Mash a few beans to thicken the mixture, then simmer for another 5 minutes."
        }
      ],
      "checklist": [],
      "timers": [
        {
          "id": "cook-4-timer-1",
          "label": "Bean simmer",
          "durationSeconds": 300
        }
      ]
    },
    {
      "id": "cook-5",
      "title": "Finish and serve",
      "instructions": [
        {
          "type": "text",
          "text": "Stir in "
        },
        {
          "type": "quantity",
          "ingredientId": "garam-masala"
        },
        {
          "type": "text",
          "text": ". Taste for salt and add a little of the optional sugar only if the acidity needs balancing. Serve over rice with warm naan if desired."
        }
      ],
      "checklist": [],
      "timers": []
    }
